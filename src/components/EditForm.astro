---
import Button from '../components/Button.astro'
---

<script>
    // @ts-nocheck
  import { fetchAPI } from "../utils/api";

  const inputFechaVenta = document.querySelector<HTMLInputElement>("#inputFechaVenta");
  const hoy = new Date();
  const anio = hoy.getFullYear();
  const mes = String(hoy.getMonth() + 1).padStart(2, "0");
  const dia = String(hoy.getDate()).padStart(2, "0");

  if(inputFechaVenta) {
    inputFechaVenta.max = `${anio}-${mes}-${dia}`;
  }

  const params = new URLSearchParams(window.location.search);
  const paramNroVenta = params.get('nro_venta')?.trim().replace('v-', '');

  let dataEnvio;
  async function getEnvio(nro_venta) {
    const res = await fetchAPI(`/envios/v-${nro_venta}`)
    const dataEnvio = res.datos[0]
    return dataEnvio;
  }

document.addEventListener("DOMContentLoaded", async () => {
    let dataEnvio = await getEnvio(paramNroVenta);

    const inputnroVenta = document.querySelector('#inputNroVenta'); 
    const inputfechaVenta = document.querySelector('#inputFechaVenta'); 
    const inputfechaEnvio = document.querySelector('#inputFechaEnvio'); 
    const inputestado = document.querySelector('#selectEstado'); 
    const inputhbl = document.querySelector('#inputHbl');
    const inputcontenedorGuia = document.querySelector('#inputContenedor');
    const inputnombre = document.querySelector('#inputNombre');
    const inputcarnet = document.querySelector('#inputCarnet');
    
    inputnroVenta.value = dataEnvio.nro_venta;
    inputfechaVenta.value = dataEnvio.fecha_venta; 
    inputfechaEnvio.value = dataEnvio.fecha_envio;
    inputestado.value = dataEnvio.estado;
    inputhbl.value = dataEnvio.hbl;
    inputcontenedorGuia.value = dataEnvio.contenedor_guia;
    inputnombre.value = dataEnvio.nombre_consignatario;
    inputcarnet.value = dataEnvio.carnet_identidad;
    
    const form = document.querySelector('.form');
    form?.addEventListener('submit', async (e) => {
        e.preventDefault();

        const fechaVenta = inputfechaVenta.value.trim()
        const fechaEnvio = inputfechaEnvio.value.trim()
        const estado = inputestado.value.trim()
        const hbl = inputhbl.value.trim()
        const contenedorGuia = inputcontenedorGuia.value.trim()
        const nombre = inputnombre.value.trim()
        const carnet = inputcarnet.value.trim()
        try {
            const res = await fetchAPI(`/envios/v-${paramNroVenta}`, {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json'
                },
                credentials: "include",
                body: JSON.stringify({
                    fecha_venta: fechaVenta,
                    fecha_envio: fechaEnvio,
                    estado,
                    hbl,
                    contenedor_guia: contenedorGuia,
                    nombre_consignatario: nombre,
                    carnet_identidad: carnet
                })
            });
            
            await alert('Envío actualizado con éxito.');

            dataEnvio = await getEnvio(paramNroVenta);
            inputfechaVenta.value = dataEnvio.fecha_venta; 
            inputfechaEnvio.value = dataEnvio.fecha_envio;
            inputestado.value = dataEnvio.estado;
            inputhbl.value = dataEnvio.hbl;
            inputcontenedorGuia.value = dataEnvio.contenedor_guia;
            inputnombre.value = dataEnvio.nombre_consignatario;
            inputcarnet.value = dataEnvio.carnet_identidad;
        } catch (error) {
            alert('Ocurrió un error.');
        }
    })
})
</script>

<form class="form">
    <div class="body-form">
        <div>
            <label for="">Nro. de venta: </label>
            <input id="inputNroVenta" type="text" placeholder="Nro. de venta" disabled>
        </div>
        <div>
            <label for="">Fecha de venta:</label>
            <input id="inputFechaVenta" type="date">
        </div>
        <div>
            <label for="">Fecha de envio:</label>
            <input id="inputFechaEnvio" type="date">
        </div>
        <div>
            <label for="">Estado:</label>
            <select id="selectEstado">
                <option value="En bodega">En bodega</option>
                <option value="Empresa de envíos">Empresa de envíos</option>
                <option value="En tránsito a Cuba">En tránsito a Cuba</option>
                <option value="En puerto Mariel">Puerto Mariel</option>
                <option value="Esperando transporte de agencia">Esperando transporte de agencia</option>
                <option value="Aduana - próximo a proceso">Aduana - próximo a proceso</option>
                <option value="Contenedor abierto - Rayos X">Contenedor abierto - Rayos X</option>
                <option value="Contenedor abierto - Unidad canina">Contenedor abierto - Unidad canina</option>
                <option value="Proceso de desagrupe">Proceso de desagrupe</option>
                <option value="Próximo a entrega">Próximo a entrega</option>
            </select>
        </div>
        <div>
            <label for="">HBL</label>
            <input id="inputHbl" type="text">
        </div>
        <div>
            <label for="">Contenedor/Guía</label>
            <input id="inputContenedor" type="text">
        </div>
        <div>
            <label for="">Nombre consignatario</label>
            <input id="inputNombre" type="text">
        </div>
        <div>
            <label for="">Carnet identidad</label>
            <input id="inputCarnet" type="text">
        </div>
    </div>
    <Button type="submit" clase='primary'>Editar</Button>
</form>

<style>

    .form {
        display: flex;
        flex-direction: column;
        row-gap: 20px;
    }

    .body-form {
        display: flex;
        flex-direction: column;
        row-gap: 8px;
    }

    label {
        font-weight: 600;
    }

    input, select { 
        padding: 10px;
        font-size: 16px;
        border-radius: 5px;
        border: 1px solid #ccc;
    }
</style>